---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import appIcon from "../assets/images/power-tools-icon.png";
import appMark from "../assets/images/power-tools-icon.svg";
import socialImage from "../assets/images/app-data-migration-light.png";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  /** Extra schema.org objects for this page, emitted as JSON-LD. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  currentPath = Astro.url.pathname,
  structuredData = []
} = Astro.props;

const site = Astro.site ?? new URL("https://powertools.abdallahnagy.com");
const absoluteUrl = (path: string) => new URL(path, site).href;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const socialImageUrl = absoluteUrl(socialImage.src);
const siteName = "PowerTools";
const githubUrl = "https://github.com/AbdallahNagy/PowerTools";

// Site-wide schema.org data. Search engines use it for rich results and to
// tie the website, the GitHub repository, and the app together.
const siteStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    alternateName: ["Power Tools", "PowerTools for Dataverse"],
    url: absoluteUrl("/")
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteName,
    alternateName: "Power Tools for Dataverse and Dynamics 365",
    description:
      "Free, open-source Windows desktop toolkit for Dataverse, Dynamics 365, and Power Platform developers. A modern alternative to XrmToolBox.",
    url: absoluteUrl("/"),
    downloadUrl: `${githubUrl}/releases/latest/download/PowerTools-Setup.exe`,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Windows",
    license: `${githubUrl}/blob/main/LICENSE`,
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    image: socialImageUrl,
    screenshot: socialImageUrl,
    sameAs: [githubUrl],
    author: {
      "@type": "Person",
      name: "Abdallah Nagy",
      url: "https://abdallahnagy.com"
    }
  }
];
const jsonLd = [...siteStructuredData, ...structuredData];

const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.replace(/\/$/, "");
const localPath = (path: string) =>
  `${basePath}${path === "/" ? "/" : path}`;
const activePath =
  basePath && currentPath.startsWith(basePath)
    ? currentPath.slice(basePath.length) || "/"
    : currentPath;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/xrmtoolbox-alternative", label: "XrmToolBox alternative" },
  { href: "/contact", label: "Contact" }
];

const isActive = (href: string) => {
  if (href === "/") {
    return activePath === "/";
  }

  return activePath.startsWith(href);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f7f9" />
    <script is:inline>
      // Light is the default. Apply a saved dark choice before first paint.
      try {
        if (localStorage.getItem("powertools-theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#14171c");
        }
      } catch {}
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={absoluteUrl("/sitemap.xml")} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Abdallah Nagy" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content="PowerTools Data Migration tool comparing two Dataverse environments" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
    <link rel="icon" type="image/svg+xml" href={appMark.src} />
    <link rel="icon" type="image/png" href={appIcon.src} />
    <link rel="apple-touch-icon" href={appIcon.src} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localPath("/")} aria-label="PowerTools home">
        <img class="brand-mark" src={appMark.src} alt="" width="34" height="34" />
        <span>PowerTools</span>
      </a>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Use dark theme"
        aria-pressed="false"
      >
        <Icon name="moon" class="theme-light-only" />
        <Icon name="sun" class="theme-dark-only" />
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-controls="site-menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="site-menu" id="site-menu">
        <nav class="site-nav" aria-label="Primary navigation">
          {
            navItems.map((item) => (
              <a href={localPath(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="header-action" href={localPath("/download")}>Download</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>PowerTools</strong>
        <span>Free, open-source desktop tools for Dataverse and Dynamics 365 developers.</span>
      </div>
      <div class="footer-links">
        <a href={localPath("/xrmtoolbox-alternative")}>XrmToolBox alternative</a>
        <a href={localPath("/download")}>Download</a>
        <a href={githubUrl}>GitHub</a>
        <a href="mailto:abdallah@abdallahnagy.com">Email</a>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      const syncThemeButton = () => {
        const isDark = root.dataset.theme === "dark";
        themeButton?.setAttribute("aria-pressed", String(isDark));
        themeButton?.setAttribute("aria-label", isDark ? "Use light theme" : "Use dark theme");
        themeColor?.setAttribute("content", isDark ? "#14171c" : "#f6f7f9");
      };

      syncThemeButton();

      themeButton?.addEventListener("click", () => {
        const isDark = root.dataset.theme !== "dark";
        if (isDark) {
          root.dataset.theme = "dark";
        } else {
          delete root.dataset.theme;
        }
        try {
          localStorage.setItem("powertools-theme", isDark ? "dark" : "light");
        } catch {}
        syncThemeButton();
      });

      const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const siteMenu = document.querySelector<HTMLElement>(".site-menu");

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        siteMenu?.classList.toggle("is-open", !isOpen);
      });
    </script>
  </body>
</html>
