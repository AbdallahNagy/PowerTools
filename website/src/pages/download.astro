---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const githubUrl = "https://github.com/AbdallahNagy/PowerTools";
const windowsDownloadUrl = `${githubUrl}/releases/latest/download/PowerTools-Setup.exe`;
---

<BaseLayout
  title="Download PowerTools for Windows: Free Dataverse Toolkit"
  description="Download PowerTools, the free open-source Windows toolkit for Dataverse and Dynamics 365 developers. Install, connect to your environment and start working."
>
  <section class="page-hero">
    <p class="eyebrow">Download</p>
    <h1>Download <br /> <span class="gradient-text">PowerTools</span></h1>
    <p class="lead">Get the latest Windows build of the open-source Dataverse developer toolkit.</p>
    <div class="hero-actions centered-actions">
      <a class="button primary" href={windowsDownloadUrl}>Download for Windows</a>
    </div>
  </section>

  <section class="section">
    <div class="download-info-grid">
      <article class="download-card">
        <span class="meta-label">Install notes</span>
        <h3>From download to first connection</h3>
        <ol class="install-steps">
          <li>
            <span>1</span>
            <p>Click <strong>Download for Windows</strong>.</p>
          </li>
          <li>
            <span>2</span>
            <p>Run the installer locally on your machine.</p>
          </li>
          <li>
            <span>3</span>
            <p>Open PowerTools and connect to your Dataverse environment.</p>
          </li>
          <li>
            <span>4</span>
            <p>Future releases are checked automatically by the installed app.</p>
          </li>
        </ol>
      </article>

      <article class="download-card security-card">
        <span class="security-icon" aria-hidden="true">
          <Icon name="shield-check" />
        </span>
        <span class="meta-label">Security reminder</span>
        <h3>Your data stays local</h3>
        <p>
          PowerTools runs on your machine and connects directly to Dataverse.
          Your Dataverse data never leaves your machine.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
