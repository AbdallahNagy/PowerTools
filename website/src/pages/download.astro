---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const githubUrl = "https://github.com/AbdallahNagy/PowerTools";
const latestDownload = `${githubUrl}/releases/latest/download`;

const platforms = [
  {
    id: "windows",
    name: "Windows",
    requirement: "Windows 10 or 11, x64",
    downloads: [{ label: "Download installer", file: "PowerTools-Setup.exe" }],
    note: "Run the installer. It installs for your user only and needs no admin rights.",
  },
  {
    id: "mac",
    name: "macOS",
    requirement: "Apple silicon or Intel",
    downloads: [
      { label: "Apple silicon", file: "PowerTools-mac-arm64.dmg" },
      { label: "Intel", file: "PowerTools-mac-x64.dmg" },
    ],
    note: "Open the disk image and drag Power Tools to Applications. If macOS cannot check the app, choose Open Anyway in System Settings > Privacy & Security.",
  },
  {
    id: "linux",
    name: "Linux",
    requirement: "x64",
    downloads: [
      { label: "AppImage", file: "PowerTools-linux-x86_64.AppImage" },
      { label: ".deb", file: "PowerTools-linux-amd64.deb" },
    ],
    note: "Install the .deb with apt, or make the AppImage executable and run it. The AppImage needs FUSE 2.",
  },
];
---

<BaseLayout
  title="Download PowerTools: Free Dataverse Tools for Windows, macOS, and Linux"
  description="Download PowerTools, the free open-source desktop toolkit for Dataverse, Dynamics 365, and Power Platform developers on Windows, macOS, and Linux."
>
  <section class="page-hero">
    <p class="eyebrow">Download</p>
    <h1>Download <br /> <span class="gradient-text">PowerTools</span></h1>
    <p class="lead">Get the latest build of the open-source Dataverse developer toolkit for Windows, macOS, or Linux.</p>
    <div class="hero-actions centered-actions">
      <a
        class="button primary"
        id="primary-download"
        href={`${latestDownload}/PowerTools-Setup.exe`}
      >
        Download for Windows
      </a>
    </div>
  </section>

  <section class="section">
    <div class="platform-grid">
      {platforms.map((platform) => (
        <article class="download-card platform-card" id={platform.id}>
          <span class="meta-label">{platform.requirement}</span>
          <h3>{platform.name}</h3>
          <div class="action-row platform-actions">
            {platform.downloads.map((download, index) => (
              <a
                class={`button ${index === 0 ? "primary" : "secondary"}`}
                href={`${latestDownload}/${download.file}`}
              >
                {download.label}
              </a>
            ))}
          </div>
          <p>{platform.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="download-info-grid">
      <article class="download-card">
        <span class="meta-label">Install notes</span>
        <h3>From download to first connection</h3>
        <ol class="install-steps">
          <li>
            <span>1</span>
            <p>Download the build for your operating system.</p>
          </li>
          <li>
            <span>2</span>
            <p>Install it locally on your machine.</p>
          </li>
          <li>
            <span>3</span>
            <p>Open PowerTools and connect to your Dataverse environment.</p>
          </li>
          <li>
            <span>4</span>
            <p>Future releases are checked automatically by the installed app.</p>
          </li>
        </ol>
      </article>

      <article class="download-card security-card">
        <span class="security-icon" aria-hidden="true">
          <Icon name="shield-check" />
        </span>
        <span class="meta-label">Security reminder</span>
        <h3>Your data stays local</h3>
        <p>
          PowerTools runs on your machine and connects directly to Dataverse.
          Your Dataverse data never leaves your machine.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  // Points the main button at the visitor's operating system. Without
  // JavaScript it stays on Windows, and every build is listed below it.
  const button = document.getElementById("primary-download");
  const agent = navigator.userAgent;
  const base = "https://github.com/AbdallahNagy/PowerTools/releases/latest/download";
  const target = /Macintosh/.test(agent)
    ? { name: "macOS (Apple silicon)", file: "PowerTools-mac-arm64.dmg" }
    : /Linux|X11/.test(agent) && !/Android/.test(agent)
      ? { name: "Linux", file: "PowerTools-linux-x86_64.AppImage" }
      : null;
  if (button && target) {
    button.textContent = `Download for ${target.name}`;
    button.setAttribute("href", `${base}/${target.file}`);
  }
</script>
