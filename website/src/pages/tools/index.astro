---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolIcon from "../../components/ToolIcon.astro";
import { PUBLIC_TOOLS, toolPath } from "../../lib/tools";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = Astro.site ?? new URL("https://powertools.abdallahnagy.com");
const absoluteUrl = (path: string) => new URL(path, site).href;

const itemListStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "PowerTools for Dataverse and Dynamics 365",
  numberOfItems: PUBLIC_TOOLS.length,
  itemListElement: PUBLIC_TOOLS.map((tool, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: tool.title,
    url: absoluteUrl(toolPath(tool.id))
  }))
};
---

<BaseLayout
  title="Dataverse and Dynamics 365 Developer Tools | PowerTools"
  description={`Every tool in PowerTools, the free open-source Windows, macOS, and Linux toolkit for Dataverse and Dynamics 365: ${PUBLIC_TOOLS.slice(0, 4).map((tool) => tool.title).join(", ")}, and more.`}
  currentPath="/tools/"
  structuredData={[itemListStructuredData]}
>
  <section class="page-hero">
    <p class="eyebrow">Tools</p>
    <h1>Tools for <span class="gradient-text">Dataverse</span> developers</h1>
    <p class="lead">
      PowerTools ships {PUBLIC_TOOLS.length} built-in tools for Dataverse,
      Dynamics 365, and Power Platform work. Each one runs on your machine
      and connects straight to your environments.
    </p>
  </section>

  <section class="section">
    <div class="tool-grid">
      {
        PUBLIC_TOOLS.map((tool) => (
          <a class="feature-card tool-card tool-link-card" href={`${basePath}${toolPath(tool.id)}`}>
            <ToolIcon id={tool.id} />
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            <span class="tool-link-more">Learn more</span>
          </a>
        ))
      }
    </div>
    <div class="action-row centered-actions">
      <a class="button secondary" href={`${basePath}/request-tool/`}>Don't see what you need? Request a tool</a>
    </div>
  </section>
</BaseLayout>
