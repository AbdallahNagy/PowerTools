---
import { getEntry, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolIcon from "../../components/ToolIcon.astro";
import { PUBLIC_TOOLS, toolPath, type PublicTool } from "../../lib/tools";

// One page per public tool. A catalog tool without a Markdown file in
// src/content/tools/ fails the build, so a new tool cannot ship unlisted.
export async function getStaticPaths() {
  return Promise.all(
    PUBLIC_TOOLS.map(async (tool) => {
      const entry = await getEntry("tools", tool.id);
      if (!entry) {
        throw new Error(
          `Missing website/src/content/tools/${tool.id}.md for public tool "${tool.title}".`
        );
      }
      return { params: { id: tool.id }, props: { tool, entry } };
    })
  );
}

interface Props {
  tool: PublicTool;
  entry: CollectionEntry<"tools">;
}

const { tool, entry } = Astro.props;
const { Content } = await entry.render();
const { seoTitle, seoDescription, xrmToolBoxEquivalent, features } = entry.data;

const githubUrl = "https://github.com/AbdallahNagy/PowerTools";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const localPath = (path: string) => `${basePath}${path}`;
const site = Astro.site ?? new URL("https://powertools.abdallahnagy.com");
const absoluteUrl = (path: string) => new URL(path, site).href;

const otherTools = PUBLIC_TOOLS.filter((other) => other.id !== tool.id);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: "Tools", item: absoluteUrl("/tools/") },
      { "@type": "ListItem", position: 3, name: tool.title, item: absoluteUrl(toolPath(tool.id)) }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: seoTitle,
    description: seoDescription,
    url: absoluteUrl(toolPath(tool.id)),
    about: {
      "@type": "SoftwareApplication",
      name: `PowerTools ${tool.title}`,
      description: tool.description,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Windows, macOS, Linux",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      isPartOf: { "@type": "SoftwareApplication", name: "PowerTools", url: absoluteUrl("/") }
    }
  }
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  currentPath="/tools/"
  structuredData={structuredData}
>
  <section class="page-hero tool-hero">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={localPath("/")}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={localPath("/tools/")}>Tools</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{tool.title}</span>
    </nav>
    <ToolIcon id={tool.id} />
    <h1>{tool.title}</h1>
    <p class="lead">{tool.description}</p>
    {
      xrmToolBoxEquivalent && (
        <p class="tool-equivalent">
          A modern take on the XrmToolBox <strong>{xrmToolBoxEquivalent}</strong> workflow, built into PowerTools.
        </p>
      )
    }
    <div class="hero-actions centered-actions">
      <a class="button primary" href={localPath("/download")}>Download PowerTools</a>
      <a class="button secondary" href={githubUrl}>View on GitHub</a>
    </div>
  </section>

  <section class="section">
    <div class="content-grid">
      <article class="tool-prose">
        <Content />
      </article>
      <aside class="download-card tool-features">
        <span class="meta-label">What you can do</span>
        <ul class="detail-list">
          {features.map((feature) => <li>{feature}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">More tools</p>
        <h2>Also in PowerTools</h2>
      </div>
    </div>
    <div class="tool-grid">
      {
        otherTools.map((other) => (
          <a class="feature-card tool-card tool-link-card" href={localPath(toolPath(other.id))}>
            <h3>{other.title}</h3>
            <p>{other.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
