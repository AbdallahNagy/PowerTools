---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import appDark from "../assets/images/app-data-migration-dark.png";
import appLight from "../assets/images/app-data-migration-light.png";
import { PUBLIC_TOOLS } from "../../../desktop/src/ui/tools/publicCatalog";

const githubUrl = "https://github.com/AbdallahNagy/PowerTools";
const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.replace(/\/$/, "");
const features = [
  {
    icon: "sparkles",
    title: "Modern UI",
    description: "A cleaner interface for Dataverse work, designed for daily use."
  },
  {
    icon: "list",
    title: "Friendly UX",
    description: "Tools are easier to figure out without digging through old dialogs."
  },
  {
    icon: "shield-check",
    title: "Local and secure",
    description: "The app runs on your machine and connects directly to Dataverse."
  },
  {
    icon: "arrow-left-right",
    title: "Open source",
    description: "Inspect the code, suggest improvements, and contribute on GitHub."
  }
] as const;

const localPath = (path: string) =>
  `${basePath}${path === "/" ? "/" : path}`;

const title = "PowerTools: Free Dataverse & Dynamics 365 Developer Toolkit";
const description =
  "Free, open-source Windows toolkit for Dataverse, Dynamics 365 and Power Platform developers: data migration, FetchXML, plug-in registration and more.";

const faqs = [
  {
    question: "What is PowerTools?",
    answer:
      "PowerTools is a free, open-source Windows desktop app for Dataverse and Dynamics 365 developers. Data migration, FetchXML queries, plug-in registration, translations and metadata work live in one workspace, and each tool opens in its own tab."
  },
  {
    question: "Is PowerTools an alternative to XrmToolBox?",
    answer:
      "PowerTools covers many of the same everyday Dataverse tasks, such as building FetchXML queries, registering plug-ins, and moving data between environments, in one modern app with a consistent interface. You can use it on its own or alongside XrmToolBox."
  },
  {
    question: "Is PowerTools free?",
    answer:
      "Yes. PowerTools is free and open source under the MIT license. The source code is on GitHub."
  },
  {
    question: "Does PowerTools work with Dynamics 365 on-premises?",
    answer:
      "Yes. PowerTools connects to Dataverse and Dynamics 365 online, and to on-premises deployments that use Active Directory or IFD authentication."
  },
  {
    question: "Where does my Dataverse data go?",
    answer:
      "Nowhere else. PowerTools runs on your machine and connects directly to your environments. No server in between stores or processes your data."
  },
  {
    question: "Which operating systems does PowerTools support?",
    answer: "The published installer is for Windows. Installed copies check for new releases automatically."
  }
];

const siteUrl = new URL(localPath("/"), Astro.site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PowerTools",
    alternateName: ["Power Tools", "PowerTools for Dataverse"],
    url: siteUrl
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "PowerTools",
    alternateName: ["Power Tools", "PowerTools for Dataverse"],
    description,
    url: siteUrl,
    downloadUrl: `${githubUrl}/releases/latest/download/PowerTools-Setup.exe`,
    image: new URL(localPath("/og-image.png"), Astro.site).href,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Dataverse and Dynamics 365 developer tools",
    operatingSystem: "Windows",
    isAccessibleForFree: true,
    license: "https://opensource.org/licenses/MIT",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: PUBLIC_TOOLS.map((tool) => tool.title),
    sameAs: [githubUrl],
    author: {
      "@type": "Person",
      name: "Abdallah Nagy",
      url: "https://github.com/AbdallahNagy"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  }
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Open-source desktop toolkit</p>
      <h1><span class="gradient-text">PowerTools</span> for Dataverse Developers</h1>
      <p class="lead">
        A free, open-source desktop toolkit for everyday Dataverse, Dynamics
        365 and Power Platform work, with a friendly UI, secure local
        workflow, and tools that are easy to figure out and use.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={localPath("/download/")}>Download for Windows</a>
        <a class="button secondary" href={githubUrl}>View on GitHub</a>
      </div>
    </div>

    <figure class="product-panel">
      <img
        class="theme-light-only"
        src={appLight.src}
        width={appLight.width}
        height={appLight.height}
        alt="PowerTools Data Migration tool comparing fields between a dev and a test environment"
      />
      <img
        class="theme-dark-only"
        src={appDark.src}
        width={appDark.width}
        height={appDark.height}
        loading="lazy"
        alt="PowerTools Data Migration tool comparing fields between a dev and a test environment"
      />
    </figure>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Why PowerTools</p>
        <h2>Dataverse tooling that feels easier to use.</h2>
      </div>
      <p>
        PowerTools focuses on developer flow: clear screens, discoverable
        actions, and less friction around the tasks you repeat every day.
      </p>
    </div>

    <div class="feature-grid">
      {
        features.map((feature) => (
          <article class="feature-card">
            <span class="feature-icon">
              <Icon name={feature.icon} />
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Current tools</p>
        <h2>A toolkit for the workflows developers need often.</h2>
      </div>
      <p>
        PowerTools is a desktop workspace for Dataverse developer tools. Each
        tool below is in the app today.
      </p>
    </div>

    <div class="tool-grid">
      {
        PUBLIC_TOOLS.map((tool) => (
          <article class="feature-card tool-card">
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="security-band">
      <p class="eyebrow">Secure by design</p>
      <h2>Your data never leaves your machine.</h2>
      <p class="lead">
        PowerTools runs locally and connects directly from the desktop app to
        your Dataverse environments. The website introduces the tool; it does
        not host or process your Dataverse data.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>Questions developers ask.</h2>
      </div>
    </div>

    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div>
      <p class="eyebrow">Open source</p>
      <h2>Built in the open for developers.</h2>
      <p class="lead">
        PowerTools is open source, so developers can inspect how it works,
        report issues, suggest improvements, and contribute.
      </p>
      <div class="action-row">
        <a class="button primary" href={localPath("/download/")}>Download for Windows</a>
        <a class="button secondary" href={githubUrl}>View on GitHub</a>
        <a class="button secondary" href={localPath("/contact/")}>Contact the author</a>
      </div>
    </div>
  </section>
</BaseLayout>
