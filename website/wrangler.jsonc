{
  // The Worker keeps its name from before the rename to Dyno, so both custom domains
  // (dyno.abdallahnagy.com and the old powertools.abdallahnagy.com) stay on it.
  "name": "power-tools",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The worker runs first so it can redirect pages on the old host; see worker/index.ts.
    "run_worker_first": true
  },
  // Anonymous daily heartbeats from the desktop app. See worker/README.md.
  "analytics_engine_datasets": [
    {
      "binding": "USAGE",
      "dataset": "power_tools_usage"
    }
  ],
  // Pull request previews. They don't inherit bindings, and a separate dataset
  // keeps test heartbeats out of the real counts.
  "previews": {
    "analytics_engine_datasets": [
      {
        "binding": "USAGE",
        "dataset": "power_tools_usage_preview"
      }
    ]
  }
}
