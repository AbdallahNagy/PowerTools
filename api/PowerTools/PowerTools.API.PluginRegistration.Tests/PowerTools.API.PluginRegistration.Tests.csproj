<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerTools.API\PowerTools.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InspectionFixtureProject Include="TestFixtures\MixedRegistrationAssembly\MixedRegistrationAssembly.csproj" />
    <InspectionFixtureProject Include="TestFixtures\RemovedHandlerAssembly\RemovedHandlerAssembly.csproj" />
    <InspectionFixtureProject Include="TestFixtures\BreakingWorkflowAssembly\BreakingWorkflowAssembly.csproj" />
    <InspectionFixtureProject Include="TestFixtures\UnsignedPluginAssembly\UnsignedPluginAssembly.csproj" />
    <InspectionFixtureProject Include="TestFixtures\MissingDependencyAssembly\MissingDependencyAssembly.csproj" />
    <InspectionFixtureProject Include="TestFixtures\UnsupportedTargetFrameworkAssembly\UnsupportedTargetFrameworkAssembly.csproj" />
    <Compile Remove="TestFixtures\**\*.cs" />
  </ItemGroup>

  <Target Name="BuildAndCopyInspectionFixtures" BeforeTargets="CoreCompile">
    <MSBuild Projects="@(InspectionFixtureProject)"
             Targets="Build"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="InspectionFixtureAssembly" />
    </MSBuild>
    <MakeDir Directories="$(OutDir)Fixtures" />
    <Copy SourceFiles="@(InspectionFixtureAssembly)"
          DestinationFolder="$(OutDir)Fixtures"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
