<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The one test project for PowerTools.API. Tests mirror the production layout:
    PowerTools.API/Tools/<Tool>/ is tested in Tools/<Tool>/ with the namespace
    PowerTools.API.Tests.Tools.<Tool>. Add a folder for a new tool, not a project.

    To run one tool's tests, filter on its namespace, for example
    FullyQualifiedName~PowerTools.API.Tests.Tools.Translator. (see AGENTS.md in this folder).
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.23" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerTools.API\PowerTools.API.csproj" />
  </ItemGroup>

  <!-- Plugin Registration inspects real plugin assemblies. Build the fixture projects and copy them to
       $(OutDir)Fixtures before compiling; they are not part of this project's own sources. -->
  <PropertyGroup>
    <PluginRegistrationFixtures>Tools\PluginRegistration\TestFixtures</PluginRegistrationFixtures>
  </PropertyGroup>
  <ItemGroup>
    <InspectionFixtureProject Include="$(PluginRegistrationFixtures)\MixedRegistrationAssembly\MixedRegistrationAssembly.csproj" />
    <InspectionFixtureProject Include="$(PluginRegistrationFixtures)\RemovedHandlerAssembly\RemovedHandlerAssembly.csproj" />
    <InspectionFixtureProject Include="$(PluginRegistrationFixtures)\BreakingWorkflowAssembly\BreakingWorkflowAssembly.csproj" />
    <InspectionFixtureProject Include="$(PluginRegistrationFixtures)\UnsignedPluginAssembly\UnsignedPluginAssembly.csproj" />
    <InspectionFixtureProject Include="$(PluginRegistrationFixtures)\MissingDependencyAssembly\MissingDependencyAssembly.csproj" />
    <InspectionFixtureProject Include="$(PluginRegistrationFixtures)\UnsupportedTargetFrameworkAssembly\UnsupportedTargetFrameworkAssembly.csproj" />
    <Compile Remove="$(PluginRegistrationFixtures)\**\*.cs" />
  </ItemGroup>

  <Target Name="BuildAndCopyInspectionFixtures" BeforeTargets="CoreCompile">
    <MSBuild Projects="@(InspectionFixtureProject)"
             Targets="Restore"
             BuildInParallel="true" />
    <MSBuild Projects="@(InspectionFixtureProject)"
             Targets="Build"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration);EnableWindowsTargeting=true">
      <Output TaskParameter="TargetOutputs" ItemName="InspectionFixtureAssembly" />
    </MSBuild>
    <MakeDir Directories="$(OutDir)Fixtures" />
    <Copy SourceFiles="@(InspectionFixtureAssembly)"
          DestinationFolder="$(OutDir)Fixtures"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
