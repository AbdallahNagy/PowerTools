{
    "appId": "com.abdalla-nagy.power-tools",
    "files": ["dist-electron", "dist-react"],
    "icon": "./power-tools.ico",
    "publish": [
        {
            "provider": "github",
            "owner": "AbdallahNagy",
            "repo": "PowerTools"
        }
    ],
    "extraResources": [
        "dist-electron/preload.cjs",
        {
            "from": "src/ui/assets/icons/power-tools-preview-256.png",
            "to": "power-tools-preview-256.png"
        }
    ],
    "mac": {
        "target": "dmg",
        "extraResources": [
            {
                "from": "../api/PowerTools/PowerTools.API/bin/Release/net9.0/osx-arm64/publish",
                "to": "api"
            }
        ]
    },
    "linux": {
        "target": "AppImage",
        "category": "Utility",
        "extraResources": [
            {
                "from": "../api/PowerTools/PowerTools.API/bin/Release/net9.0/linux-x64/publish",
                "to": "api"
            }
        ]
    },
    "win": {
        "target": ["nsis"],
        "artifactName": "PowerTools-Setup.${ext}",
        "extraResources": [
            {
                "from": "../api/PowerTools/PowerTools.API/bin/Release/net9.0/win-x64/publish",
                "to": "api"
            }
        ]
    },
    "nsis": {
        "oneClick": true,
        "perMachine": false
    }
}
