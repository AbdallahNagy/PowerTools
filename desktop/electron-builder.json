{
    "appId": "com.abdalla-nagy.power-tools",
    "files": ["dist-electron", "dist-react"],
    "icon": "./dyno.ico",
    "publish": [
        {
            "provider": "github",
            "owner": "AbdallahNagy",
            "repo": "Dyno",
            "releaseType": "release"
        }
    ],
    "extraResources": [
        "dist-electron/preload.bundle.cjs",
        {
            "from": "src/ui/assets/icons/dyno-icon-256.png",
            "to": "dyno-icon-256.png"
        }
    ],
    "mac": {
        "target": "dmg",
        "icon": "./dyno.icns",
        "extraResources": [
            {
                "from": "../api/Dyno/Dyno.Api/bin/Release/net9.0/osx-arm64/publish",
                "to": "api"
            }
        ]
    },
    "linux": {
        "target": "AppImage",
        "category": "Utility",
        "icon": "./dyno.png",
        "extraResources": [
            {
                "from": "../api/Dyno/Dyno.Api/bin/Release/net9.0/linux-x64/publish",
                "to": "api"
            }
        ]
    },
    "win": {
        "target": ["nsis"],
        "artifactName": "Dyno-Setup.${ext}",
        "extraResources": [
            {
                "from": "../api/Dyno/Dyno.Api/bin/Release/net9.0/win-x64/publish",
                "to": "api"
            },
            {
                "from": "../api/Dyno/Dyno.McpConnector/bin/Release/net9.0/win-x64/publish/Dyno.McpConnector.exe",
                "to": "mcp-connector/Dyno.McpConnector.exe"
            }
        ]
    },
    "nsis": {
        "oneClick": true,
        "perMachine": false
    }
}
