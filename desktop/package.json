{
  "name": "power-tools",
  "productName": "Power Tools",
  "author": "Abdallah Nagy",
  "private": true,
  "version": "0.1.0-beta.4",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all -p dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "build:renderer": "vite build",
    "test": "npm run transpile:electron && vitest run",
    "test:coverage": "npm run transpile:electron && vitest run --coverage",
    "test:smoke": "npm run transpile:electron && npm run build:renderer && npm run test:smoke:run",
    "test:smoke:run": "playwright test test/smoke/app.spec.ts",
    "typecheck": "tsc -b && tsc --project tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint -- --max-warnings 0 && npm test && npm run build:renderer && npm run test:smoke:run",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json && esbuild dist-electron/preload.cjs --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.bundle.cjs --log-level=warning",
    "publish:api:win": "dotnet publish ../api/PowerTools/PowerTools.API -c Release -r win-x64 -p:PublishingForSidecar=true",
    "publish:api:mac": "dotnet publish ../api/PowerTools/PowerTools.API -c Release -r osx-arm64 -p:PublishingForSidecar=true",
    "publish:api:linux": "dotnet publish ../api/PowerTools/PowerTools.API -c Release -r linux-x64 -p:PublishingForSidecar=true",
    "dist:mac": "npm run publish:api:mac && npm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run publish:api:linux && npm run transpile:electron && npm run build && electron-builder --linux --x64",
    "dist:win": "npm run publish:api:win && npm run transpile:electron && npm run build && electron-builder --win --x64 --publish never",
    "release:win": "npm run publish:api:win && npm run transpile:electron && npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@azure/msal-node": "^2.0.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "axios": "^1.15.0",
    "electron-updater": "^6.8.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^39.1.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
