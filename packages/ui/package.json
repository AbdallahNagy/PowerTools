{
  "name": "@powertools/ui",
  "version": "0.1.0",
  "description": "Power Tools UI kit and theme for community tools. Built from the desktop app's shared UI source.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/types/packages/ui/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/packages/ui/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./code-editor": {
      "types": "./dist/types/packages/ui/src/code-editor.d.ts",
      "import": "./dist/code-editor.js",
      "default": "./dist/code-editor.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.styles.config.ts && vite build && tsc --project tsconfig.build.json && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
